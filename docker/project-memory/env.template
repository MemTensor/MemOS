# 本地部署用的 .env 模板：由 make_env.py 填值，不要手改 __...__ 之外的占位。
# 只放本地部署需要的最小集合；公司 PolarDB / Redis / 网关的配置一律不进来。

# ── 核心（MemOS 原有能力）──────────────────────────────────────────────────
MOS_CHAT_MODEL=__MOS_CHAT_MODEL__
OPENAI_API_KEY=__OPENAI_API_KEY__
OPENAI_API_BASE=__OPENAI_API_BASE__
MEMRADER_MODEL=__MEMRADER_MODEL__
MEMRADER_API_KEY=__MEMRADER_API_KEY__
MEMRADER_API_BASE=__MEMRADER_API_BASE__
MEMREADER_GENERAL_MODEL=__MEMREADER_GENERAL_MODEL__
PREFERENCE_EXTRACTOR_MODEL=__PREFERENCE_EXTRACTOR_MODEL__
FEEDBACK_MODEL=__FEEDBACK_MODEL__
SUGGESTION_MODEL=__SUGGESTION_MODEL__
MEMSCHEDULER_MODEL=__MEMSCHEDULER_MODEL__

MOS_EMBEDDER_BACKEND=__MOS_EMBEDDER_BACKEND__
MOS_EMBEDDER_PROVIDER=__MOS_EMBEDDER_PROVIDER__
MOS_EMBEDDER_MODEL=__MOS_EMBEDDER_MODEL__
MOS_EMBEDDER_API_BASE=__MOS_EMBEDDER_API_BASE__
MOS_EMBEDDER_API_KEY=__MOS_EMBEDDER_API_KEY__
EMBEDDING_DIMENSION=__EMBEDDING_DIMENSION__
MOS_RERANKER_BACKEND=cosine_local

# 核心图库 = compose 里的 neo4j 容器（社区版，向量在 qdrant 容器；不是本机、不是共享库）
GRAPH_DB_BACKEND=neo4j-community
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=projectmemory
NEO4J_DB_NAME=neo4j
MOS_NEO4J_SHARED_DB=false
NEO4J_AUTO_CREATE=true
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# 单机：用进程内队列，不起 Redis
MEMSCHEDULER_USE_REDIS_QUEUE=false
ENABLE_CHAT_API=false

# ── 项目记忆（memory view `project`）────────────────────────────────────────
MEMOS_ENABLED_PLUGINS=project_memory

# 存储：项目记忆用自己的 PostgreSQL（compose 里的 pm-postgres，pgvector 镜像）。
# 多副本 / 多 worker 共享同一份数据；带 rev 条件写与中文全文检索。
# 不放进 Neo4j：neo4j 两种后端的全文检索都是空实现、也没有 rev 条件写。
# 改回单文件 SQLite（只适合单进程）：PROJECT_MEMORY_GRAPH_DB=sqlite
PROJECT_MEMORY_GRAPH_DB=postgres
PROJECT_MEMORY_POSTGRES_USER=memos
PROJECT_MEMORY_POSTGRES_PASSWORD=projectmemory
PROJECT_MEMORY_POSTGRES_DB=project_memory
PROJECT_MEMORY_POSTGRES_SCHEMA=project_memory
PROJECT_MEMORY_SQLITE_PATH=/data/project_memory/project_memory.db
PROJECT_MEMORY_EMBEDDER_DIMENSION=__EMBEDDING_DIMENSION__

# 模型：抽取、更新、合并、归主题；温度 0
PROJECT_MEMORY_LLM_BACKEND=openai
PROJECT_MEMORY_LLM_MODEL=__MOS_CHAT_MODEL__
PROJECT_MEMORY_LLM_API_BASE=__OPENAI_API_BASE__
PROJECT_MEMORY_LLM_API_KEY=__OPENAI_API_KEY__
PROJECT_MEMORY_LLM_TEMPERATURE=0
PROJECT_MEMORY_LLM_MAX_TOKENS=4096

# 判别题（段关系）：可换成更便宜的模型；这里先用同一个
PROJECT_MEMORY_JUDGE_LLM_MODEL=__MOS_CHAT_MODEL__
PROJECT_MEMORY_JUDGE_LLM_API_BASE=__OPENAI_API_BASE__
PROJECT_MEMORY_JUDGE_LLM_API_KEY=__OPENAI_API_KEY__

# 向量模型
PROJECT_MEMORY_EMBEDDER_BACKEND=__MOS_EMBEDDER_BACKEND__
PROJECT_MEMORY_EMBEDDER_PROVIDER=__MOS_EMBEDDER_PROVIDER__
PROJECT_MEMORY_EMBEDDER_MODEL=__MOS_EMBEDDER_MODEL__
PROJECT_MEMORY_EMBEDDER_API_BASE=__MOS_EMBEDDER_API_BASE__
PROJECT_MEMORY_EMBEDDER_API_KEY=__MOS_EMBEDDER_API_KEY__

# 空闲关段阈值（分钟）与调试
PROJECT_MEMORY_IDLE_MINUTES=30
PROJECT_MEMORY_DEBUG_TRACE=false
